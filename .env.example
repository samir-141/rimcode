# =============================================================================
# RimCode · variables de entorno
# =============================================================================

# Sitio
NEXT_PUBLIC_APP_URL=http://localhost:3000

NEXT_PUBLIC_CONTACT_EMAIL=jhonergomez20@gmail.com

NEXT_PUBLIC_WHATSAPP_NUMBER=929284937

# -----------------------------------------------------------------------------
# Clasificación local de Rimy (Next.js)
# -----------------------------------------------------------------------------
# Ejecuta services/intent/server.py en la misma máquina para activar ONNX.
RIMY_INTENT_ENABLED=0
RIMY_INTENT_PORT=8820
# Opcional. Directorio absoluto y privado, con una clave de al menos 32 caracteres.
RIMY_LOG_DIR=
RIMY_LOG_SIGNING_KEY=
# -----------------------------------------------------------------------------
# Envío de contacto - RESEND
# -----------------------------------------------------------------------------
CONTACT_PROVIDER=resend

RESEND_API_KEY=re_TU_API_KEY

CONTACT_EMAIL=jhonergomez20@gmail.com

CONTACT_FROM_EMAIL=RimCode <onboarding@resend.dev>

# -----------------------------------------------------------------------------
# Webhook (alternativa a Resend)
# -----------------------------------------------------------------------------
CONTACT_WEBHOOK_URL=
CONTACT_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# RIMY
# -----------------------------------------------------------------------------
NEXT_PUBLIC_RIMY_RIVE_SRC=
RIMY_TTS_ENABLED=0
RIMY_TTS_URL=http://127.0.0.1:8810/synthesize
RIMY_TTS_TOKEN=
RIMY_TTS_SIGNING_KEY=

# Encabezado de IP único, validado y sobrescrito por un proxy administrado.
# Dejar vacío si no hay un proxy confiable.
RIMCODE_TRUSTED_IP_HEADER=
# Límites compartidos opcionales (Upstash Redis REST).
RIMCODE_REDIS_REST_URL=
RIMCODE_REDIS_REST_TOKEN=
